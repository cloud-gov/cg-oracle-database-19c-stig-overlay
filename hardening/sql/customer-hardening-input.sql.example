-- customer-hardening-input.sql -- customer-owned, reviewed, non-secret input.
--
-- Copy this file to a customer-specific path, choose and review each value,
-- then run:
--   make harden-customer-cloudgov HARDENING_INPUT=path/to/customer-hardening-input.sql
--
-- Do not place database credentials in this file. The target uses the bound
-- service credentials available only through VCAP_SERVICES in cg-sqlcl-oracle-cf.
--
-- TRUST BOUNDARY: this input is not validated or sanitized before SQLcl processes
-- it. The operator who controls this input also controls the Cloud Foundry account
-- and bound-service access used to execute it, and therefore already has full
-- authority to run SQL against the target instance. Treat this file as privileged,
-- reviewed operational input; do not accept it from an untrusted source.

-- Y assigns Oracle-supplied ORA_STIG_PROFILE to eligible non-Oracle accounts.
-- Set N to report profile-assignment candidates without assigning them; review
-- candidates before choosing Y. The combined run still alters the database via
-- scripts 10, 12, 15, 20, 30, and 60; N is not a dry-run mode.
DEFINE assign_users = Y

-- Oracle identifier for the approved password verification function applied to
-- DEFAULT. ORA12C_STIG_VERIFY_FUNCTION is Oracle-supplied; use a reviewed,
-- existing site function only when the organization requires a custom policy.
DEFINE verify_function = ORA12C_STIG_VERIFY_FUNCTION

-- Positive whole-number reserve subtracted from the instance SESSIONS ceiling
-- to set DEFAULT.SESSIONS_PER_USER. This is organization-defined: account for
-- the connection-pool workload and retain enough capacity for RDS operations.
DEFINE session_headroom = 64
